{
  "name": "pesk",
  "version": "0.2.1",
  "description": "Animated Windows desktop pet.",
  "main": "build/main.js",
  "author": "dev6699",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "test": "npm run build && npm run typecheck:tests && jest --runInBand",
    "test:e2e": "node scripts/test-e2e.js",
    "test:e2e:headed": "node scripts/test-e2e.js --headed",
    "test:e2e:screenshots": "node scripts/test-e2e.js --project=electron e2e/specs/docs/screenshots.desktop.spec.ts",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "release": "node scripts/release-publish.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.pesk.app",
    "productName": "Pesk",
    "files": [
      "build/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/pesk.ico",
      "artifactName": "Pesk-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "marked": "^18.0.11",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  }
}
