{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": "build/renderer",
    "rootDir": "src/renderer",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/renderer/features/**/*.ts",
    "src/renderer/shared/**/*.ts",
    "src/renderer/web/**/*.ts",
    "src/renderer/shared/types.d.ts"
  ]
}
